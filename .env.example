# Local secrets: copy to .env; .env is excluded by .gitignore.
DB_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Exact existing Ollama model name from: ollama list
# Leave blank to let start.sh select the first installed model.
OLLAMA_MODEL=
# Host machine Ollama, not a Docker container.
OLLAMA_DOCKER_URL=http://host.docker.internal:11434
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
